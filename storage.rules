rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // PDFの読み取りは認証済みユーザーのみ。
    // 書き込みは Admin SDK（openai-processor / repair-missing-pdfs）経由のみで、
    // Admin SDK はルールを経由しないためクライアント書き込みは全面拒否。
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
