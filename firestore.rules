rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // appointments: 認証済みユーザーは読み取り可。
    // 書き込みはローカルツール用の読み取り専用アカウント(local@niraissc.jp)以外の認証済みユーザーのみ。
    match /appointments/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email != "local@niraissc.jp";
    }
    // 上記以外のコレクションへのクライアントアクセスは全て拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
