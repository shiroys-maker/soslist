rules_version = '2';
// Approved temporary containment, 2026-10-17 JST.
// Temporary containment: preserves the legacy writer's existing local workflow.
// 2026-11-11 passkey login (passkey-server issues custom tokens with passkey=true for the same accounts):
//  - passkey sessions expire 6 hours after sign-in (auth_time)
//  - passkey sessions may read like password sessions, but may only make the edits the web screen offers
//    (no create/delete, no other fields, no dailyBrief_ documents). Password sessions (local tools) unchanged.
service cloud.firestore {
  match /databases/{database}/documents {
    function passwordSession() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function passkeySession() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.get('passkey', false) == true
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(6, 'h');
    }
    function readerUid() { return request.auth.uid in ['MsMNpta5iBfNnXh0sXGiAsIQKw22', 'jpnoE4ygk5ZqR8rsaJnzRSy5poA3']; }
    function writerUid() { return request.auth.uid == 'jpnoE4ygk5ZqR8rsaJnzRSy5poA3'; }

    // ---- Edits the web screen can make (field-level, mirrors script.js / shared/core.js) ----
    function two(n) { return n < 10 ? '0' + string(n) : string(n); }
    function year4(n) {
      return n < 10 ? '000' + string(n) : n < 100 ? '00' + string(n) : n < 1000 ? '0' + string(n) : string(n);
    }
    // 'MM/DD HH:MM' (saveVisitDate)
    function visitDateOk(v) {
      return v is string && v.matches('^((0[13578]|1[02])/(0[1-9]|[12][0-9]|3[01])|(0[469]|11)/(0[1-9]|[12][0-9]|30)|02/(0[1-9]|1[0-9]|2[0-9])) ([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    // Appointment date/time edit: JST slot 9-11,13-16 h, 0/15/30/45 min; string must match the timestamp.
    function appointmentOk(a) {
      let local = a.appointmentDateTime + duration.value(9, 'h');
      return a.appointmentDate is string
        && a.appointmentDateTime is timestamp && a.processedAt is timestamp
        && a.appointmentDateTime.nanos() == 0 && local.seconds() == 0
        && local.hours() in [9, 10, 11, 13, 14, 15, 16]
        && local.minutes() in [0, 15, 30, 45]
        && a.appointmentDate == year4(local.year()) + '-' + two(local.month()) + '-' + two(local.day()) + 'T' + two(local.hours()) + ':' + two(local.minutes()) + ':00';
    }
    function referralFieldOk(prior, next, dest) {
      return prior is map && next is map
        && ((next.diff(prior).affectedKeys().hasOnly(['isReceived']) && next.isReceived is bool)
          || (next.diff(prior).affectedKeys().hasOnly(['isCompleted']) && next.isCompleted is bool)
          || (dest != 'LAB' && next.diff(prior).affectedKeys().hasOnly(['visitDate']) && visitDateOk(next.visitDate)));
    }
    function referralOk(dest) {
      let b = resource.data.get('referrals', {});
      let a = request.resource.data.get('referrals', {});
      return b is map && a is map
        && a.diff(b).affectedKeys().hasOnly([dest])
        && referralFieldOk(b.get(dest, {}), a.get(dest, {}), dest);
    }
    function webEditOk() {
      let a = request.resource.data;
      let changed = a.diff(resource.data).affectedKeys();
      return changed.size() == 0
        || (changed.hasOnly(['isShown']) && a.isShown is bool)
        || (changed.hasOnly(['isReceived']) && a.isReceived is bool)
        || (changed.hasOnly(['isCompleted']) && a.isCompleted is bool)
        || (changed.hasOnly(['isAgePink']) && a.isAgePink is bool)
        || (changed.hasOnly(['japanCellPhone']) && a.japanCellPhone is string && a.japanCellPhone.size() <= 100)
        || (changed.hasOnly(['visitDate']) && visitDateOk(a.visitDate))
        || (changed.hasOnly(['appointmentDate', 'appointmentDateTime', 'processedAt']) && appointmentOk(a))
        || (changed.hasOnly(['referrals']) && (referralOk('ASBO') || referralOk('KIN') || referralOk('ANSHIN') || referralOk('LAB')));
    }

    match /appointments/{docId} {
      allow read: if (passwordSession() || passkeySession()) && readerUid();
      allow write: if passwordSession() && writerUid();
      allow update: if passkeySession() && writerUid() && !docId.matches('^dailyBrief_.*') && webEditOk();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
