# openai-processor の環境変数
# このファイルを .env にコピーして値を設定する（.env はgit管理外）

# OpenAI APIキー（必須）
OPENAI_API_KEY=sk-...

# Firebase Admin のサービスアカウントJSONのパス（~ 可）
GOOGLE_APPLICATION_CREDENTIALS=~/.config/firebase/sos-list-service-account.json

# 監視するPDFフォルダ（省略時: ~/Library/CloudStorage/Dropbox/VA/SOSPDF）
# SOSPDF_WATCH_FOLDER=/path/to/folder
