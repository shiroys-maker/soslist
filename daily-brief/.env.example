# daily-brief 用の環境変数サンプル。
# このファイルを「.env」にコピーして値を埋めてください(.env はGit管理外)。

# --- 必須 ---
# Gemini音声生成用（Google AI Studioで発行したAPIキー）
export GEMINI_API_KEY="your-gemini-api-key"

# Firebaseサービスアカウントの鍵ファイル(JSON)へのフルパス。
# openai-processor を動かしている認証情報と同じものでOK。
export GOOGLE_APPLICATION_CREDENTIALS="/Users/shungohiroyasu/secrets/sos-list-service-account.json"

